{
  "name": "omnipraxis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "viewer:build": "tsc -p tsconfig.app.json && vite build --config vite.viewer.config.ts && tsc -p tsconfig.viewer.json",
    "viewer:check": "node scripts/record-viewer-check.ts --start && pnpm lint && pnpm build && pnpm viewer:build && pnpm desktop:renderer:build && firebase emulators:exec --config prototypes/phase1/firebase.json --project demo-omnipraxis-phase1 --only firestore,storage \"pnpm viewer:test && pnpm viewer:test:browser\" && node scripts/record-viewer-check.ts",
    "viewer:dev": "vite --config prototypes/phase1/vite.config.ts",
    "viewer:emulators": "firebase emulators:start --config prototypes/phase1/firebase.json --project demo-omnipraxis-phase1 --only firestore,storage",
    "viewer:seed": "node prototypes/phase1/seed.ts",
    "viewer:test": "node --test tests/phase1/*.test.ts",
    "viewer:test:browser": "playwright test --config prototypes/phase1/playwright.config.ts",
    "backend:build": "pnpm --dir functions build && tsc -p tsconfig.backend-tests.json",
    "backend:test": "pnpm --dir functions test",
    "backend:emulators": "firebase emulators:start --project demo-omnipraxis --only auth,firestore,storage,functions",
    "backend:check": "pnpm backend:build && firebase emulators:exec --project demo-omnipraxis --only auth,firestore,storage,functions \"pnpm backend:test\"",
    "desktop:dev": "tauri dev",
    "desktop:renderer:dev": "vite --config vite.desktop.config.ts",
    "desktop:renderer:build": "tsc -b && vite build --config vite.desktop.config.ts",
    "desktop:build": "tauri build --no-bundle",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "public-viewer:build": "tsc -p tsconfig.app.json && vite build --config vite.public-viewer.config.ts && tsc -p tsconfig.public-viewer.json",
    "portal:build": "pnpm viewer:build && pnpm public-viewer:build && ng build portal && tsc -p tsconfig.portal-tests.json",
    "portal:dev": "pnpm viewer:build && pnpm public-viewer:build && ng serve portal",
    "portal:test": "playwright test --config portal/playwright.config.ts",
    "portal:check": "pnpm backend:build && pnpm portal:build && firebase emulators:exec --project demo-omnipraxis --only auth,firestore,storage,functions \"pnpm portal:test\"",
    "portal:seed": "node scripts/seed-portal.ts",
    "portal:preview": "node portal/serve.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@convai/web-sdk": "^1.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@react-three/xr": "^6.6.29",
    "@sparkjsdev/spark": "^2.1.0",
    "@tauri-apps/api": "^2.11.1",
    "firebase": "^13.0.0",
    "leva": "^0.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rxjs": "7.8.2",
    "three": "^0.184.0",
    "tslib": "2.8.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.33.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12"
  }
}
