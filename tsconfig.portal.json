{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@omnipraxis/viewer": ["./build/viewer/types/index.d.ts"],
      "@omnipraxis/public-viewer": ["./build/public-viewer/types/index.d.ts"]
    }
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "files": ["portal/src/main.ts"]
}
